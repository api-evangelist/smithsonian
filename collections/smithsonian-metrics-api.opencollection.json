{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smithsonian Open Access content metrics API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get CC0 statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.si.edu/openaccess/api/v1.0/stats",
            "params": [
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "API key received from https://api.data.gov/signup/"
              }
            ]
          },
          "docs": "Fetches statistics for CC0 objects and media across all Smithsonian collections."
        }
      ]
    }
  ],
  "bundled": true
}